    {
      "id": "-c8WKAEl6yd5N6cK8hHbL",
      "type": "text",
      "x": 158.40000915527344,
      "y": 408.1000671386719,
      "width": 602.6990966796875,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
