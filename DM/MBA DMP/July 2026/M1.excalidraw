      "isDeleted": false,
      "boundElements": null,
      "updated": 1783702156539,
      "link": null,
      "locked": false,
      "text": "Opportunities: rising\nfood delivery culture in\nKathmandu (Foodmandu,\nPathao Foods),\nInstagram-driven cake\ntrends, festival/wedding\nseason demand spikes,\nlow digital competition\namong local bakeries",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Opportunities: rising food delivery culture in Kathmandu (Foodmandu, Pathao Foods), Instagram-driven cake trends, festival/wedding season demand spikes, low digital competition among local bakeries",
      "autoResize": false,
      "lineHeight": 1.25
    },
